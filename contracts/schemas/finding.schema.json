{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kontur.local/schemas/finding.schema.json",
  "title": "Finding",
  "description": "Атомарная находка. CONFIRMED_VIOLATION допустим только при заполненном inspector_decision.",
  "type": "object",
  "required": [
    "finding_id",
    "rule_code",
    "finding_status",
    "review_priority",
    "versions"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "evidence_group_id": { "type": ["string", "null"] },
    "rule_code": { "type": "string" },
    "section": { "type": "string" },
    "expected_value": { "type": ["string", "number", "boolean", "null"] },
    "actual_value": { "type": ["string", "number", "boolean", "null"] },
    "delta": { "type": ["string", "number", "null"] },
    "finding_status": {
      "type": "string",
      "description": "AUTO_NO_DIFFERENCE — внутренний статус автомата (развилка п. 9.2 и 9.3). Во внешний протокол ТЗ и в ИАИС «РиН» не сериализуется: ждёт ответа организатора на вопрос 8. Карточки с этим статусом кладутся в sections.preliminary_no_difference.",
      "enum": [
        "CANDIDATE",
        "CONFIRMED_VIOLATION",
        "NEGATIVE_VERIFIED",
        "AUTO_NO_DIFFERENCE",
        "MISSING_EVIDENCE",
        "NOT_APPLICABLE",
        "NOT_COMPARABLE",
        "LOW_QUALITY",
        "ABSTAIN",
        "CLARIFICATION_REQUIRED",
        "SUSPICION"
      ]
    },
    "counts_as_violation": {
      "type": "boolean",
      "description": "true допустим исключительно при finding_status = CONFIRMED_VIOLATION"
    },
    "review_priority": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "Очередь экспертной проверки. Не юридическая тяжесть и не основание для предписания."
    },
    "rationale": {
      "type": "string",
      "description": "Детерминированное обоснование компаратора. Черновик пояснения от LLM хранится отдельно в llm_draft и не влияет на статус."
    },
    "llm_draft": { "type": ["string", "null"] },
    "source_id": {
      "type": ["string", "null"],
      "description": "file_id эталона (ПД). Не заменяет evidence_group_id."
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Идентификаторы фрагментов группы. Пустой список допустим только если ключ опущен."
    },
    "disagreement_kind": {
      "type": ["string", "null"],
      "enum": [
        "VALUE_DELTA",
        "MISSING_IN_STAGE",
        "AMBIGUOUS_REFERENCE",
        "FORMAT_MISMATCH",
        null
      ]
    },
    "normative_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "clause", "effective_from"],
        "properties": {
          "identifier": { "type": "string" },
          "issuer": { "type": "string" },
          "clause": { "type": "string" },
          "effective_from": { "type": "string", "format": "date" },
          "effective_to": { "type": ["string", "null"], "format": "date" },
          "layer": {
            "type": "string",
            "enum": ["organizer_matrix", "current_overlay"],
            "description": "Вердикт считается по organizer_matrix; current_overlay только предупреждает."
          }
        }
      }
    },
    "inspector_decision": {
      "type": ["object", "null"],
      "required": ["inspector_id", "action", "timestamp"],
      "properties": {
        "inspector_id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["CONFIRM", "REJECT", "REQUEST_CLARIFICATION"]
        },
        "reason_code": { "type": ["string", "null"] },
        "comment": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "versions": {
      "type": "object",
      "required": ["matrix_version", "rule_version", "model_version"],
      "properties": {
        "matrix_version": { "type": "string" },
        "rule_version": { "type": "string" },
        "model_version": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "finding_status": {
            "enum": [
              "CANDIDATE",
              "CONFIRMED_VIOLATION",
              "NEGATIVE_VERIFIED",
              "AUTO_NO_DIFFERENCE"
            ]
          }
        },
        "required": ["finding_status"]
      },
      "then": {
        "properties": { "evidence_group_id": { "type": "string" } },
        "required": ["evidence_group_id"]
      }
    },
    {
      "if": {
        "properties": { "counts_as_violation": { "const": true } },
        "required": ["counts_as_violation"]
      },
      "then": {
        "properties": { "finding_status": { "const": "CONFIRMED_VIOLATION" } }
      }
    },
    {
      "if": {
        "properties": { "finding_status": { "const": "CONFIRMED_VIOLATION" } },
        "required": ["finding_status"]
      },
      "then": {
        "properties": {
          "inspector_decision": {
            "type": "object",
            "required": ["inspector_id", "action", "timestamp", "comment"],
            "properties": {
              "action": { "const": "CONFIRM" },
              "comment": { "type": "string", "minLength": 1 }
            }
          },
          "counts_as_violation": { "const": true }
        },
        "required": ["inspector_decision", "evidence_group_id", "counts_as_violation"]
      }
    },
    {
      "if": {
        "properties": { "finding_status": { "const": "NEGATIVE_VERIFIED" } },
        "required": ["finding_status"]
      },
      "then": {
        "properties": {
          "inspector_decision": {
            "type": "object",
            "required": ["inspector_id", "action", "timestamp", "reason_code", "comment"],
            "properties": {
              "action": { "const": "REJECT" },
              "reason_code": { "type": "string", "minLength": 1 },
              "comment": { "type": "string", "minLength": 1 }
            }
          }
        },
        "required": ["inspector_decision"]
      }
    }
  ],
  "additionalProperties": false
}
