# Ядро
KONTUR_DB_URL=postgresql://kontur:kontur@localhost:5432/kontur
KONTUR_REDIS_URL=redis://localhost:6379/0
KONTUR_AMQP_URL=amqp://guest:guest@localhost:5672/
KONTUR_OBJECT_STORE_URL=http://localhost:9000

# Версии, попадающие в каждый результат и протокол
KONTUR_MATRIX_VERSION=draft-0
KONTUR_DATASET_VERSION=none
KONTUR_MODEL_VERSION=none

# Лимиты загрузки по ТЗ п. 9.1
KONTUR_MAX_FILE_BYTES=52428800
KONTUR_MAX_BATCH_BYTES=209715200

# Внешняя ИС. Пока контракт не подтверждён sandbox-ом, режим только mock.
KONTUR_RIN_MODE=mock
KONTUR_RIN_BASE_URL=
KONTUR_RIN_CLIENT_CERT=

# Модели. Пустое значение означает работу без модели: это допустимый режим,
# в котором система обязана честно возвращать ABSTAIN и NOT_SUPPORTED.
KONTUR_OCR_ENGINE=
KONTUR_VLM_ENDPOINT=
